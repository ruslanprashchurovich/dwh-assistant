# ==================== Database (Docker & App) ====================
# Эти переменные используются для инициализации контейнера PostgreSQL в Docker.
POSTGRES_DB="dwh"
POSTGRES_USER="dwh_user"
POSTGRES_PASSWORD="dwh_password"

# Настройки подключения приложения к БД.
# Для локального запуска укажите параметры вашего внешнего/локального Postgres.
# При запуске через Docker compose эти параметры переопределяются автоматически на контейнер 'db'.
PG_STUDENT_HOST="localhost"
PG_STUDENT_PORT=5432
PG_STUDENT_DBNAME="dwh"
PG_STUDENT_USER="dwh_user"
PG_STUDENT_PASSWORD="dwh_password"

# Список таблиц для анализа в DWH
TABLES=["countries", "..."]  # Укажите здесь свои таблицы для анализа

# ==================== General ====================
DEBUG_MODE=0
LLM_PROVIDER="yandex"  # Допустимые значения: yandex, openai, anthropic
USE_SYSTEM_PROMPT=1

# ==================== YandexGPT ====================
YANDEX_CLOUD_API_KEY=...
YANDEX_CLOUD_FOLDER=...
YANDEX_CLOUD_MODEL="aliceai-llm/latest"

# ==================== OpenAI (ChatGPT) ====================
OPENAI_API_KEY=...
OPENAI_MODEL="gpt-4o-mini"

# ==================== Anthropic (Claude) ====================
ANTHROPIC_API_KEY=...
ANTHROPIC_MODEL="claude-haiku-4-5"
